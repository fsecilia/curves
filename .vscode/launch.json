{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Curves",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "environment": [
                {
                    "name": "GTEST_COLOR",
                    "value": "1"
                }
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "all + kbuild"
        },
        {
            "name": "Debug Curves - VM",
            "type": "cppdbg",
            "request": "launch",
            "program": "/host/dev/build/debian/build/gcc/Debug/installed/bin/curves-mouse-acceleration-config",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/host/dev/build/debian/build/gcc/Debug/installed/lib"
                }
            ],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false
        }
    ]
}