CompileFlags:
  Remove:
    - -fext-numeric-literals
    - -mno-direct-extern-access
  Add:
    - -Wno-unused-function

---

Completion:
  HeaderInsertion: Never

---

If:
  PathMatch: .*/crv/kernel/cxx/.*

CompileFlags:
  Add: [-x, c++-header]

---

Diagnostics:
  ClangTidy:
    CheckOptions:
      bugprone-unused-return-value.AllowCastToVoid: true
