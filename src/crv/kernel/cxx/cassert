#ifndef CRV_KERNEL_CXX_CASSERT_HPP
#define CRV_KERNEL_CXX_CASSERT_HPP

#include <source_location>

extern "C" [[noreturn]] void panic(char const* fmt, ...);

namespace crv {

[[noreturn]] static inline auto kernel_assert_failed(
    char const* expression_string, std::source_location const source_location = std::source_location::current()) -> void
{
    panic("%s:%u: %s: Assertion `%s' failed.", source_location.file_name(), source_location.line(),
        source_location.function_name(), expression_string);
}

} // namespace crv

#endif // #ifndef CRV_KERNEL_CXX_CASSERT_HPP

#undef assert

#ifndef NDEBUG
#define assert(expr) (static_cast<bool>(expr) ? static_cast<void>(0) : ::crv::kernel_assert_failed(#expr))
#else
#define assert(expr) ((void)0)
#endif
